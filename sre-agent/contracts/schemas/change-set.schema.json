{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-finops:v2:change-set",
  "title": "Agentic FinOps Change Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "change_set_id", "version", "scope_hash", "created_by",
    "created_at_utc", "classification", "objective", "resources", "commands",
    "preconditions", "dry_run", "expected_diff", "blast_radius", "canary",
    "postconditions", "rollback_or_compensation", "risk", "valid_until_utc",
    "change_set_hash", "status"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "change_set_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "scope_hash": { "$ref": "#/$defs/sha256" },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "classification": { "enum": ["REVERSIBLE", "COMPENSATABLE", "IRREVERSIBLE"] },
    "objective": { "type": "string", "minLength": 1 },
    "resources": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["order", "runtime_tool_name", "exact_command", "idempotency_key"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "runtime_tool_name": { "type": "string", "minLength": 1 },
          "exact_command": { "type": "string", "minLength": 1 },
          "idempotency_key": { "type": "string", "minLength": 1 }
        }
      }
    },
    "preconditions": { "$ref": "#/$defs/stringList" },
    "dry_run": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "evidence_ref"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "expected_diff": { "type": "string", "minLength": 1 },
    "blast_radius": { "type": "string", "minLength": 1 },
    "canary": { "$ref": "#/$defs/stringList" },
    "postconditions": { "$ref": "#/$defs/stringList" },
    "rollback_or_compensation": { "$ref": "#/$defs/stringList" },
    "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "valid_until_utc": { "type": "string", "format": "date-time" },
    "change_set_hash": { "$ref": "#/$defs/sha256" },
    "status": {
      "enum": ["PROPOSED", "APPROVED", "EXECUTING", "VERIFIED", "ROLLED_BACK", "REJECTED", "EXPIRED", "BLOCKED"]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "stringList": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
