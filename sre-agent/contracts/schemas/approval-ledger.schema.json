{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-finops:v2:approval-ledger",
  "title": "Agentic FinOps Approval Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "entries"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "ledger_id": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "approval_id", "change_set_id", "change_set_hash", "decision",
          "approver", "decided_at_utc", "valid_from_utc", "valid_until_utc",
          "resources", "commands_hash", "scope_hash", "reason"
        ],
        "properties": {
          "approval_id": { "type": "string", "minLength": 1 },
          "change_set_id": { "type": "string", "minLength": 1 },
          "change_set_hash": { "$ref": "#/$defs/sha256" },
          "decision": { "enum": ["APPROVED", "REJECTED", "REVOKED"] },
          "approver": { "type": "string", "minLength": 1 },
          "decided_at_utc": { "type": "string", "format": "date-time" },
          "valid_from_utc": { "type": "string", "format": "date-time" },
          "valid_until_utc": { "type": "string", "format": "date-time" },
          "resources": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "commands_hash": { "$ref": "#/$defs/sha256" },
          "scope_hash": { "$ref": "#/$defs/sha256" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
