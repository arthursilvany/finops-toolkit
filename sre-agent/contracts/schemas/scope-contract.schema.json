{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-finops:v2:scope-contract",
  "title": "Agentic FinOps Scope Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scope_id", "tenant", "subscriptions", "resource_groups",
    "environments", "period", "currency", "sources", "exclusions",
    "classification", "limits", "approval"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "scope_id": { "type": "string", "minLength": 1 },
    "tenant": { "type": "string", "minLength": 1 },
    "subscriptions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "resource_groups": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "environments": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "period": {
      "type": "object", "additionalProperties": false,
      "required": ["start_utc", "end_utc"],
      "properties": {
        "start_utc": { "type": "string", "format": "date-time" },
        "end_utc": { "type": "string", "format": "date-time" }
      }
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "sources": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "exclusions": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "classification": {
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "HIGHLY_CONFIDENTIAL"]
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_resources", "max_rows", "max_query_bytes"],
      "properties": {
        "max_resources": { "type": "integer", "minimum": 1 },
        "max_rows": { "type": "integer", "minimum": 1 },
        "max_query_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["approved_by", "approved_at_utc", "valid_until_utc", "scope_hash"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at_utc": { "type": "string", "format": "date-time" },
        "valid_until_utc": { "type": "string", "format": "date-time" },
        "scope_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
