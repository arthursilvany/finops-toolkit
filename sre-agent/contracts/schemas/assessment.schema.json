{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-finops:v2:assessment",
  "title": "Agentic FinOps Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "assessment_id", "execution_id", "epoch",
    "scope_hash", "created_at_utc", "frameworks", "dimensions", "overall"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "assessment_id": { "type": "string", "minLength": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "epoch": { "type": "integer", "minimum": 0 },
    "scope_hash": { "$ref": "#/$defs/sha256" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "frameworks": {
      "type": "object", "additionalProperties": false,
      "required": ["finops_framework", "state_of_finops_2026", "zero_ops_rubric"],
      "properties": {
        "finops_framework": {
          "allOf": [
            { "$ref": "#/$defs/reference" },
            { "properties": { "role": { "const": "NORMATIVE" } } }
          ]
        },
        "state_of_finops_2026": {
          "allOf": [
            { "$ref": "#/$defs/reference" },
            { "properties": { "role": { "const": "INDUSTRY_SIGNAL" } } }
          ]
        },
        "zero_ops_rubric": {
          "allOf": [
            { "$ref": "#/$defs/reference" },
            { "properties": { "role": { "const": "CUSTOM_RUBRIC" } } }
          ]
        }
      }
    },
    "dimensions": {
      "type": "array", "items": { "$ref": "#/$defs/dimension" }
    },
    "overall": {
      "type": "object", "additionalProperties": false,
      "required": ["score", "confidence", "eligible_count", "total_count", "formula"],
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW", "INSUFFICIENT"] },
        "eligible_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 0 },
        "formula": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version_or_date", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version_or_date": { "type": "string", "minLength": 1 },
        "role": { "enum": ["NORMATIVE", "INDUSTRY_SIGNAL", "CUSTOM_RUBRIC"] }
      }
    },
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": [
        "dimension_id", "name", "official_capability", "status", "score",
        "weight", "confidence", "evidence_refs", "gaps", "recommendations"
      ],
      "properties": {
        "dimension_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "official_capability": { "type": ["string", "null"] },
        "status": { "enum": ["ASSESSED", "PARTIAL", "SEM_ACESSO", "NA"] },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW", "INSUFFICIENT"] },
        "evidence_refs": {
          "type": "array", "items": { "type": "string", "minLength": 1 }
        },
        "gaps": { "type": "array", "items": { "type": "string" } },
        "recommendations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
