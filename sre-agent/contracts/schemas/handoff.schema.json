{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-finops:v2:handoff",
  "title": "Agentic FinOps Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "handoff_id", "execution_id", "idempotency_key",
    "from_agent_id", "to_agent_id", "created_at_utc", "scope_hash", "epoch",
    "objective", "state", "evidence_refs", "missing_data", "requested_action",
    "autonomy_limit", "completion_criteria", "turn", "max_turns"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "handoff_id": { "type": "string", "minLength": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "from_agent_id": { "$ref": "#/$defs/agentId" },
    "to_agent_id": { "$ref": "#/$defs/agentId" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "scope_hash": { "$ref": "#/$defs/sha256" },
    "epoch": { "type": "integer", "minimum": 0 },
    "objective": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["RECEIVED", "VALIDATING", "RUNNING", "PARTIAL_SUCCESS", "AWAITING_APPROVAL", "BLOCKED", "FAILED", "COMPLETED"]
    },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "missing_data": { "type": "array", "items": { "type": "string" } },
    "requested_action": { "type": "string", "minLength": 1 },
    "autonomy_limit": { "enum": ["READ_ONLY", "REVIEW_FIRST", "HUMAN_ONLY"] },
    "completion_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "turn": { "type": "integer", "minimum": 1 },
    "max_turns": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "agentId": {
      "enum": [
        "finops-orchestrator", "data-quality-agent", "optimization-agent",
        "anomaly-agent", "governance-agent", "executive-roi-agent",
        "cost-flow-agent", "alerting-agent", "incident-agent",
        "commitment-agent", "change-canary-agent", "human-operator"
      ]
    }
  }
}
